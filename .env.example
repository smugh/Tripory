# Tripory Environment Configuration (Example)
# Catatan: Jangan menyimpan private secrets, API keys privat, atau kredensial produksi di sini.

# Environment: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# SQLite local database name
EXPO_PUBLIC_DATABASE_NAME=tripory.db

# Enable automated local migration logs during development
EXPO_PUBLIC_ENABLE_DEV_LOGS=true
